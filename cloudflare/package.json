{
  "name": "worker-warden-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "cf workers types",
    "check": "npm run types && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "cf build",
    "dev": "cf dev",
    "preflight": "node scripts/check-secrets.mjs",
    "deploy": "npm run preflight && cf deploy --secrets-file .secrets.json",
    "deploy:ci": "node scripts/deploy-ci.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "cf": "1.0.0-beta.12",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
